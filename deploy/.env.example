# Copy to deploy/.env and fill in. Never commit the real file.

# Database password. Letters and digits only: it is placed inside a URL.
POSTGRES_PASSWORD=change_me_to_a_long_random_value

# Laravel application key: 32 random bytes. Generate one with:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Public address of the site, used in links.
APP_URL=http://localhost

# Port the site listens on.
HTTP_PORT=80

# Market maker cycle in milliseconds.
BOT_INTERVAL_MS=1000
